# --- MongoDB ---
# Local dev default (docker-compose). Swap for an Atlas SRV URI for cross-device persistence.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smart_watchlist

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./chroma_data

# --- LLM (Ask-Why RAG). Leave blank to run in grounded-fallback mode without an LLM. ---
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Market data ---
MARKET_DATA_PROVIDER=yfinance

# --- App ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEMO_MODE=false

# --- Auth (lightweight session, no OAuth) ---
SESSION_SECRET=change-me-in-prod
